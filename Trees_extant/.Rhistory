summary(m2)
AIC(m1, m2, m3)
anova(m1, m2, test = "Chisq")   # Does PercentageMorphCharacters improve the model?
anova(m2, m3, test = "Chisq")   # Is the interaction significant?
# Best model
summary(m2)
# Statistical interaction analyses with ML MKv
# Model 1: bootstrap only
m1 <- glmer(
occurrence_tree2 ~ support_tree1 + (1 | Dataset),
data = MLASClogistic,
family = binomial
)
# Model 2: additive effects
m2 <- glmer(
occurrence_tree2 ~ support_tree1 + PercentageMorphCharacters + (1 | Dataset),
data = MLASClogistic,
family = binomial
)
# Model 3: interaction
m3 <- glmer(
occurrence_tree2 ~ support_tree1 * PercentageMorphCharacters + (1 | Dataset),
data = MLASClogistic,
family = binomial
)
# Selection
AIC(m1, m2, m3)
anova(m1, m2, test = "Chisq")   # Does PercentageMorphCharacters improve the model?
anova(m2, m3, test = "Chisq")   # Is the interaction significant?
# Best model
summary(m2)
AIC(m1, m2, m3)
# Selection
AIC(m1, m2, m3)
AIC(m1, m2, m3)
anova(m1, m2, test = "Chisq")   # Does PercentageMorphCharacters improve the model?
anova(m2, m3, test = "Chisq")   # Is the interaction significant?
# Best model
summary(m2)
