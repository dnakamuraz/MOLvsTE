# Statistical interaction analyses with MP
# Model 1: bootstrap only
m1 <- glm(
occurrence_tree2 ~ support_tree1,
data = MPlogistic,
family = binomial
)
# Model 2: additive effects
m2 <- glm(
occurrence_tree2 ~ support_tree1 + PercentageMorphCharacters,
data = MPlogistic,
family = binomial
)
# Model 3: interaction
m3 <- glm(
occurrence_tree2 ~ support_tree1 * PercentageMorphCharacters,
data = MPlogistic,
family = binomial
)
# Selection
AIC(m1, m2, m3)
anova(m1, m2, test = "Chisq")   # Does PercentageMorphCharacters improve the model?
anova(m2, m3, test = "Chisq")   # Is the interaction significant?
r
# Best model
summary(m3)
# Best model
summary(m3)
# Statistical interaction analyses with MP
# Model 1: bootstrap only
m1 <- glmer(
occurrence_tree2 ~ support_tree1 + (1 | Dataset),
data = MPlogistic,
family = binomial
)
# Model 2: additive effects
m2 <- glmer(
occurrence_tree2 ~ support_tree1 + PercentageMorphCharacters + (1 | Dataset),
data = MPlogistic,
family = binomial
)
# Model 3: interaction
m3 <- glmer(
occurrence_tree2 ~ support_tree1 * PercentageMorphCharacters + (1 | Dataset),
data = MPlogistic,
family = binomial
)
# Selection
AIC(m1, m2, m3)
anova(m1, m2, test = "Chisq")   # Does PercentageMorphCharacters improve the model?
anova(m2, m3, test = "Chisq")   # Is the interaction significant?
# Best model
summary(m3)
# Show confidence intervals and convert log-odds to oddds ratios
exp(cbind(
OR = coef(m3),
confint(m3)
))
